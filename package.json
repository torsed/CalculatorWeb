{
  "name": "calculator-web",
  "version": "1.0.0",
  "description": "Scientific calculator with pure vanilla JS - parser, stats, matrices, number theory, graphics",
  "scripts": {
    "start": "start index.html",
    "test": "node tests/smoke.js && node tests/run_vectors.js && node tests/chem_balance.test.js && node tests/core_ext.test.js && node tests/core_deep.test.js",
    "test:smoke": "node tests/smoke.js",
    "test:vectors": "node tests/run_vectors.js",
    "test:chem": "node tests/chem_balance.test.js",
    "test:core": "node tests/core_ext.test.js",
    "test:e2e": "playwright test",
    "test:coverage": "c8 node tests/coverage.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tests playwright.config.js",
    "lint:fix": "eslint src tests --ext .js,.cjs,.mjs --fix",
    "format:check": "prettier --check src tests index.html"
  },
  "keywords": [
    "calculator",
    "math",
    "science",
    "vanilla-js",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
